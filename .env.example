# Copy to .env and fill in. Never commit a real .env.
# Twilio — create at https://www.twilio.com/try-twilio (your name + card).
# Buy a phone number in the console, then copy the SID/token from the dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1

# OpenAI — create at https://platform.openai.com/api-keys (your card).
# Needs Realtime API access.
OPENAI_API_KEY=

# Public URL of this server (your tunnel, e.g. https://abc123.ngrok.io).
# Twilio calls <PUBLIC_BASE_URL>/voice and streams to wss://<host>/media.
PUBLIC_BASE_URL=

# Your mobile — the server texts you a short summary after every call.
OWNER_PHONE=+1
